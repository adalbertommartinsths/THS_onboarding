{
  "framework": null,
  "installCommand": "unset NPM_CONFIG_CACHE_DIR npm_config_cache_dir; npm install",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
